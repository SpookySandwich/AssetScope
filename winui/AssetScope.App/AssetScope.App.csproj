<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AssetScope.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
    <AssemblyTitle>AssetScope</AssemblyTitle>
    <AssemblyName>assetscope</AssemblyName>
    <Product>AssetScope</Product>
    <ApplicationIcon>Assets\assetscope.ico</ApplicationIcon>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AssetScope.Core\AssetScope.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\assetscope.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\assetscope.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Institutions\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Securities\*.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
