<!--
    Default layout density (§21.1).

    These styles live in their own dictionary rather than in App.xaml so the
    compact variant can override them. A ResourceDictionary searches its own
    entries before its MergedDictionaries, so keys declared directly in App.xaml
    could never be overridden by a merged dictionary; keys declared here can,
    because Density.Compact.xaml is merged after this one and later merged
    dictionaries win. Density.Compact.xaml must redeclare every key below.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Card surface shared by every page. -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ReferenceCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ReferenceCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="HeroCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="SubtleCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="HeroAmountStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="36" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="StatAmountStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="CaptionSecondaryStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Small primary text: the value half of a dense label/value row. -->
    <Style x:Key="CaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- A heading inside a card ("Biggest misses", "Spending by category"). -->
    <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Inset tile inside a card: a label, a figure, a caption. -->
    <Style x:Key="StatTileStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ReferenceNeutralTintBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style x:Key="StatValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Primary pages fill the NavigationView content viewport. A shared
         MaxWidth here used to center the whole dashboard on wide windows,
         creating a false left gutter while fixed/minimum child columns
         continued past the right edge. Individual cards constrain readable
         text; the page shell itself must stretch. -->
    <Style x:Key="ReferencePageStackStyle" TargetType="StackPanel">
        <Setter Property="Padding" Value="28,0,28,28" />
        <Setter Property="Spacing" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="ReferencePageGridStyle" TargetType="Grid">
        <Setter Property="Padding" Value="28,0,28,28" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

</ResourceDictionary>
