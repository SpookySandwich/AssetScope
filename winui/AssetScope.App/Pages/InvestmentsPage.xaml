<Page
    x:Class="AssetScope.App.Pages.InvestmentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AssetScope.App.Controls"
    AutomationProperties.AutomationId="InvestmentsPage"
    Background="{ThemeResource AppCanvasBrush}"
    NavigationCacheMode="Required">

    <!--
        The page fills the viewport instead of growing with its data: buying more
        securities must lengthen the holdings list, not the page. PageScroll is
        therefore disabled while the two-column layout is in effect, and each
        list card scrolls inside its own border. Below the stacked breakpoint
        four full-width cards cannot fit any viewport, so the code-behind hands
        scrolling back to the page.
    -->
    <ScrollViewer x:Name="PageScroll"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden"
                  HorizontalContentAlignment="Stretch">
        <Grid x:Name="PageRoot" Style="{StaticResource ReferencePageGridStyle}" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="ContentRow" Height="*" />
            </Grid.RowDefinitions>

            <controls:PageHeader x:Name="Header" Grid.Row="0" />

            <InfoBar x:Name="ErrorBar" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Error" />

            <StackPanel x:Name="EmptyState" Grid.Row="2" Visibility="Collapsed" Spacing="12"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Center" Margin="0,80,0,0" MaxWidth="440">
                <FontIcon Glyph="&#xEB05;" FontSize="44"
                          HorizontalAlignment="Center" Foreground="{ThemeResource ReferenceBlueTextBrush}" />
                <TextBlock x:Name="InvestmentsEmptyTitleText" x:Uid="InvestmentsEmptyTitle" FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Uid="InvestmentsEmptyBody"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Uid="InvestmentsOpenSettings" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center" Click="OpenSettings_Click"
                        AutomationProperties.AutomationId="InvestmentsOpenSettings" />
            </StackPanel>

            <Grid x:Name="InvestmentContent" Grid.Row="2" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="MainColumn" Width="2.05*" MinWidth="620" />
                    <ColumnDefinition x:Name="SideColumn" Width="1*" MinWidth="300" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- The list row absorbs the leftover height so both list
                         cards end at the same baseline. The code-behind owns
                         the height and floor; see ApplyResponsiveLayout. -->
                    <RowDefinition x:Name="ListRow" Height="*" MinHeight="200" />
                </Grid.RowDefinitions>

                <Border x:Name="PortfolioCard" Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource HeroCardStyle}"
                        AutomationProperties.AutomationId="InvestmentPortfolioCard">
                    <StackPanel Spacing="18">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="PortfolioLogoHost" Width="36" Height="36" />
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="PortfolioNameText" FontSize="18" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <TextBlock x:Uid="InvestmentsPerformancePeriod" Grid.Column="2" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>

                        <Grid ColumnSpacing="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="0.85*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="InvestmentsTotalValueLabel" Style="{StaticResource CaptionSecondaryStyle}" />
                                <TextBlock x:Name="TotalValueText" FontSize="32" FontWeight="SemiBold"
                                           AutomationProperties.AutomationId="InvestmentTotalValueText" />
                                <TextBlock x:Uid="InvestmentsUnrealizedGainLabel"
                                           Style="{StaticResource CaptionSecondaryStyle}" Margin="0,4,0,0" />
                                <TextBlock x:Name="TotalGainText"
                                           AutomationProperties.AutomationId="InvestmentUnrealizedGainText" />
                            </StackPanel>
                            <Rectangle Grid.Column="1" Width="1" Fill="{ThemeResource ReferenceCardStrokeBrush}"
                                       HorizontalAlignment="Center" />
                            <StackPanel Grid.Column="2" Spacing="5">
                                <TextBlock x:Uid="InvestmentsCashLabel" Style="{StaticResource CaptionSecondaryStyle}" />
                                <TextBlock x:Name="CashText" FontSize="28" FontWeight="SemiBold" />
                                <TextBlock x:Name="CashShareText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <controls:TrendChart x:Name="PerformanceChart" Grid.Column="3"
                                                 Height="132" ShowYAxis="False" ShowXAxis="False"
                                                 LineThickness="2" FillOpacity="100" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="AllocationCard" Grid.Row="0" Grid.Column="1"
                        Style="{StaticResource CardStyle}"
                        AutomationProperties.AutomationId="InvestmentAllocationCard">
                    <StackPanel Spacing="14">
                        <TextBlock x:Uid="InvestmentsAllocationTitle" Style="{StaticResource CardTitleStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <controls:DonutChart x:Name="AllocationDonut" Height="190" RingThickness="26" />
                            <StackPanel x:Name="AllocationLegend" Grid.Column="1" Spacing="14"
                                        VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="HoldingsCard" Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource CardStyle}" VerticalAlignment="Stretch"
                        AutomationProperties.AutomationId="InvestmentHoldingsCard">
                    <!-- Title and column headers stay pinned; only the rows scroll. -->
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Holdings, cached activity and cached orders share one
                             card; the ledger views used to hide in a dialog. -->
                        <Grid Grid.Row="0" ColumnSpacing="12" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <SelectorBar x:Name="HoldingsViewBar"
                                         AutomationProperties.AutomationId="InvestmentsViewBar"
                                         SelectionChanged="HoldingsViewBar_SelectionChanged">
                                <SelectorBarItem x:Name="HoldingsViewItem" x:Uid="InvestmentsViewHoldings" Tag="holdings" />
                                <SelectorBarItem x:Uid="InvestmentsViewActivity" Tag="activity" />
                                <SelectorBarItem x:Uid="InvestmentsViewOrders" Tag="orders" />
                            </SelectorBar>
                            <TextBlock x:Name="LedgerNoteText" Grid.Column="1" Visibility="Collapsed"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Right"
                                       Style="{StaticResource CaptionSecondaryStyle}" />
                        </Grid>
                        <Grid x:Name="HoldingsHeaderGrid" Grid.Row="1" ColumnSpacing="10" Padding="4,4,4,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="0.65*" />
                                <ColumnDefinition Width="0.72*" />
                                <ColumnDefinition Width="0.78*" />
                                <ColumnDefinition Width="1.0*" />
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="0.7*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="InvestmentsColName" Style="{StaticResource CaptionSecondaryStyle}" />
                            <TextBlock x:Uid="InvestmentsColType" Grid.Column="1" Style="{StaticResource CaptionSecondaryStyle}" />
                            <TextBlock x:Uid="InvestmentsColUnits" Grid.Column="2" Style="{StaticResource CaptionSecondaryStyle}" TextAlignment="Right" />
                            <TextBlock x:Uid="InvestmentsColPrice" Grid.Column="3" Style="{StaticResource CaptionSecondaryStyle}" TextAlignment="Right" />
                            <TextBlock x:Uid="InvestmentsColValue" Grid.Column="4" Style="{StaticResource CaptionSecondaryStyle}" TextAlignment="Right" />
                            <TextBlock x:Uid="InvestmentsColGain" Grid.Column="5" Style="{StaticResource CaptionSecondaryStyle}" TextAlignment="Right" />
                            <TextBlock x:Uid="InvestmentsColAllocation" Grid.Column="6" Style="{StaticResource CaptionSecondaryStyle}" TextAlignment="Right" />
                        </Grid>
                        <ScrollViewer x:Name="HoldingsScroll" Grid.Row="2"
                                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Rectangle Height="1" Fill="{ThemeResource ReferenceCardStrokeBrush}" />
                                <StackPanel x:Name="HoldingsRows" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border x:Name="RealizedCard" Grid.Row="1" Grid.Column="1"
                        Style="{StaticResource CardStyle}" VerticalAlignment="Stretch"
                        AutomationProperties.AutomationId="InvestmentRealizedCard">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" x:Uid="InvestmentsRealizedTitle"
                                   Style="{StaticResource CardTitleStyle}" />

                        <StackPanel Grid.Row="1" Spacing="8">
                            <TextBlock x:Uid="InvestmentsRealizedTotalLabel" Style="{StaticResource CaptionSecondaryStyle}" />
                            <TextBlock x:Name="RealizedTotalText" FontSize="26" FontWeight="SemiBold"
                                       AutomationProperties.AutomationId="InvestmentRealizedTotalText" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Uid="InvestmentsRealizedYtdLabel" Style="{StaticResource CaptionSecondaryStyle}" />
                                    <TextBlock x:Name="RealizedYtdText" FontWeight="SemiBold"
                                               AutomationProperties.AutomationId="InvestmentRealizedYtdText" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Uid="InvestmentsRealizedMtdLabel" Style="{StaticResource CaptionSecondaryStyle}" />
                                    <TextBlock x:Name="RealizedMtdText" FontWeight="SemiBold"
                                               AutomationProperties.AutomationId="InvestmentRealizedMtdText" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="RealizedBasisWarning" Visibility="Collapsed"
                                       TextWrapping="Wrap" Style="{StaticResource CaptionSecondaryStyle}"
                                       AutomationProperties.AutomationId="InvestmentRealizedBasisWarning" />
                            <TextBlock x:Name="RealizedEmptyText" x:Uid="InvestmentsRealizedEmpty"
                                       Visibility="Collapsed" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ScrollViewer x:Name="RealizedScroll" Grid.Row="2"
                                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Rectangle Height="1" Fill="{ThemeResource ReferenceCardStrokeBrush}" />
                                <StackPanel x:Name="RealizedRows" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
