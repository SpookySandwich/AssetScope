<Page
    x:Class="AssetScope.App.Pages.TrendsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mux="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:AssetScope.App.Controls"
    AutomationProperties.AutomationId="TrendsPage"
    Background="{ThemeResource AppCanvasBrush}"
    NavigationCacheMode="Required">

    <ScrollViewer HorizontalContentAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Hidden">
        <StackPanel Style="{StaticResource ReferencePageStackStyle}">
            <controls:PageHeader x:Name="Header" />

            <Grid x:Name="MainLayoutGrid" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TrendsPrimaryColumn" Width="*" MinWidth="480" />
                    <ColumnDefinition x:Name="TrendsSummaryColumn" Width="360" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="PrimaryContentPanel" Spacing="16"
                            AutomationProperties.AutomationId="TrendsContent">
                    <!-- Primary chart (SPEC §20.1) -->
                    <Border Style="{StaticResource HeroCardStyle}">
                        <StackPanel Spacing="10">
                            <Grid>
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock x:Uid="NetWorthTitle" Style="{StaticResource CardTitleStyle}"
                                                   VerticalAlignment="Center" />
                                        <Button x:Name="NetWorthInfoButton"
                                                Style="{StaticResource InfoTipButtonStyle}"
                                                AutomationProperties.AutomationId="TrendsNetWorthInfoButton">
                                            <FontIcon Glyph="&#xE946;" FontSize="12"
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <Button.Flyout>
                                                <Flyout Placement="Bottom">
                                                    <TextBlock x:Name="NetWorthInfoFlyoutText"
                                                               x:Uid="NetWorthTooltip"
                                                               TextWrapping="Wrap" MaxWidth="320" />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock x:Name="NetWorthText" Style="{StaticResource HeroAmountStyle}" FontSize="30"
                                               AutomationProperties.AutomationId="TrendsNetWorthText" />
                                    <controls:ChangeBadge x:Name="NetWorthChange" AmountFontSize="13" />
                                </StackPanel>
                                <mux:SelectorBar x:Name="RangeBar"
                                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                                 AutomationProperties.AutomationId="TrendsRangeBar"
                                                 SelectionChanged="RangeBar_SelectionChanged">
                                    <mux:SelectorBarItem x:Uid="TrendsRange1M" Tag="1m" />
                                    <mux:SelectorBarItem x:Uid="TrendsRange3M" Tag="3m" />
                                    <mux:SelectorBarItem x:Name="RangeOneYearItem" x:Uid="TrendsRange1Y" Tag="1y" />
                                    <mux:SelectorBarItem x:Uid="RangeAll" Tag="all" />
                                </mux:SelectorBar>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="16" Visibility="Collapsed">
                                <CheckBox x:Name="ShowAssetsCheck" x:Uid="SeriesAssets" Checked="SeriesToggled" Unchecked="SeriesToggled" />
                                <CheckBox x:Name="ShowLiabilitiesCheck" x:Uid="SeriesLiabilities" Checked="SeriesToggled" Unchecked="SeriesToggled" />
                            </StackPanel>
                            <controls:TrendChart x:Name="Chart" Height="190"
                                                 XTickCount="11" YTickCount="4"
                                                 LineThickness="1.8" FillOpacity="112" />
                        </StackPanel>
                    </Border>

                    <!-- Summary cards (SPEC §20.2): balance change only, never "return" -->
                    <Grid x:Name="SummaryCardsGrid" ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border x:Name="NetWorthSummaryCard" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="10" Background="{ThemeResource ReferenceBlueTintBrush}" VerticalAlignment="Top">
                                    <FontIcon Glyph="&#xE9D2;" FontSize="19"
                                              Foreground="{ThemeResource ReferenceBlueTextBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock x:Uid="NetWorthTitle" Style="{StaticResource CaptionSecondaryStyle}" />
                                    <TextBlock x:Name="KpiNetWorthText" Style="{StaticResource StatValueStyle}" />
                                    <controls:ChangeBadge x:Name="KpiNetWorthChange" StackAmountAndRatio="True" />
                                    <TextBlock x:Name="NetWorthPeriodText" Style="{StaticResource CaptionSecondaryStyle}" />
                                </StackPanel>
                                <controls:Sparkline x:Name="NetWorthSpark" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Border x:Name="BankSummaryCard" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="14">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="10" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" VerticalAlignment="Top">
                                    <FontIcon Glyph="&#xE8C7;" FontSize="19" Foreground="{StaticResource ReferenceGreenBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock x:Uid="BankCashBalanceLabel" Style="{StaticResource CaptionSecondaryStyle}" />
                                    <TextBlock x:Name="BankText" Style="{StaticResource StatValueStyle}" />
                                    <controls:ChangeBadge x:Name="BankChange" StackAmountAndRatio="True" />
                                    <TextBlock x:Name="BankPeriodText" Style="{StaticResource CaptionSecondaryStyle}" />
                                </StackPanel>
                                <controls:Sparkline x:Name="BankSpark" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Border x:Name="InvestmentSummaryCard" Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="10" Background="{ThemeResource ReferencePurpleTintBrush}" VerticalAlignment="Top">
                                    <FontIcon Glyph="&#xEB05;" FontSize="19"
                                              Foreground="{StaticResource ReferencePurpleBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock x:Uid="InvestmentBalanceLabel" Style="{StaticResource CaptionSecondaryStyle}" />
                                    <TextBlock x:Name="InvestmentText" Style="{StaticResource StatValueStyle}" />
                                    <controls:ChangeBadge x:Name="InvestmentChange" StackAmountAndRatio="True" />
                                    <TextBlock x:Name="InvestmentPeriodText" Style="{StaticResource CaptionSecondaryStyle}" />
                                </StackPanel>
                                <controls:Sparkline x:Name="InvestmentSpark" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Border x:Name="LiabilitiesSummaryCard" Grid.Column="3" Style="{StaticResource CardStyle}" Padding="14">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="10" Background="{ThemeResource ReferenceRedTintBrush}" VerticalAlignment="Top">
                                    <FontIcon Glyph="&#xE8C7;" FontSize="19" Foreground="{StaticResource ReferenceRedBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock x:Uid="HomeCreditCardLiabilities" Style="{StaticResource CaptionSecondaryStyle}" />
                                    <TextBlock x:Name="LiabilitiesText" Style="{StaticResource StatValueStyle}" />
                                    <controls:ChangeBadge x:Name="LiabilitiesChange" StackAmountAndRatio="True" />
                                    <TextBlock x:Name="LiabilitiesPeriodText" Style="{StaticResource CaptionSecondaryStyle}" />
                                </StackPanel>
                                <controls:Sparkline x:Name="LiabilitiesSpark" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Grid>
                    <!-- Stacked category chart (SPEC §20.3) -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock x:Uid="InstitutionContributionTitle" Style="{StaticResource CardTitleStyle}" />
                                    <Button Style="{StaticResource InfoTipButtonStyle}">
                                        <FontIcon Glyph="&#xE946;" FontSize="12"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <Button.Flyout>
                                            <Flyout Placement="Bottom">
                                                <TextBlock x:Uid="InstitutionContributionTooltip"
                                                           TextWrapping="Wrap" MaxWidth="300" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                                <Button x:Name="ExportCsvButton" x:Uid="ExportCsv" HorizontalAlignment="Right"
                                        Visibility="Collapsed" FontSize="12" Padding="10,4,10,4" Click="ExportCsvButton_Click" />
                            </Grid>
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="CategoryLegend" Spacing="6"
                                            VerticalAlignment="Center" />
                                <controls:ContributionAreaChart x:Name="CategoryChart" Grid.Column="1" Height="170"
                                                                AutomationProperties.AutomationId="InstitutionContributionChart" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Deterministic summaries (SPEC §20.4) -->
                <StackPanel x:Name="TrendsRightRail" Grid.Column="1" Spacing="16" VerticalAlignment="Top">
                    <Border x:Name="PeriodSummaryCard" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Uid="TrendSummaryTitle" Style="{StaticResource CardTitleStyle}" />
                                <Button Style="{StaticResource InfoTipButtonStyle}">
                                    <FontIcon Glyph="&#xE946;" FontSize="12"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">
                                            <TextBlock x:Uid="TrendSummaryDisclaimer"
                                                       TextWrapping="Wrap" MaxWidth="300" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                            <StackPanel x:Name="SummaryLines" Spacing="14" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
