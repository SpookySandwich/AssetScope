<Page
    x:Class="AssetScope.App.Pages.RewardsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mux="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:AssetScope.App.Controls"
    AutomationProperties.AutomationId="RewardsPage"
    Background="{ThemeResource AppCanvasBrush}"
    NavigationCacheMode="Required">

    <!-- Viewport-sized shell like Living: each column scrolls inside. The left
         column answers "which card for this purchase", then shows what recent
         spending earned and the full ranking; the right column is where the
         user says which card each account is. -->
    <Grid Style="{StaticResource ReferencePageGridStyle}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="16">
            <controls:PageHeader x:Name="Header" />
            <mux:InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="True" Severity="Error" />
        </StackPanel>

        <StackPanel x:Name="EmptyState" Grid.Row="1" Visibility="Collapsed" Spacing="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
            <Border Width="56" Height="56" CornerRadius="14" HorizontalAlignment="Center"
                    Background="{ThemeResource ReferenceBlueTintBrush}">
                <FontIcon Glyph="&#xE8C7;" FontSize="24" Foreground="{ThemeResource ReferenceBlueTextBrush}" />
            </Border>
            <TextBlock x:Name="EmptyTitleText" x:Uid="RewardsEmptyTitle" HorizontalAlignment="Center"
                       Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Uid="RewardsEmptyBody" HorizontalAlignment="Center" TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid x:Name="ContentGrid" Grid.Row="1" AutomationProperties.AutomationId="RewardsContent"
              ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PrimaryColumn" Width="2*" MinWidth="460" />
                <ColumnDefinition x:Name="SecondaryColumn" Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="PrimaryScroller" Grid.Column="0"
                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Auto" VerticalScrollBarVisibility="Hidden">
                <StackPanel x:Name="PrimaryPanel" Spacing="16">

                    <!-- The short answer: which card to reach for, and for what -->
                    <Border x:Name="PlanCard" Style="{StaticResource HeroCardStyle}"
                            AutomationProperties.AutomationId="RewardsPlanCard">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock x:Uid="RewardsPlanTitle" Style="{StaticResource CardTitleStyle}"
                                               VerticalAlignment="Center" />
                                    <Button x:Name="AboutButton" Style="{StaticResource InfoTipButtonStyle}"
                                            AutomationProperties.AutomationId="RewardsAboutButton">
                                        <FontIcon Glyph="&#xE946;" FontSize="12"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <Button.Flyout>
                                            <Flyout Placement="Bottom">
                                                <StackPanel Spacing="6" MaxWidth="340">
                                                    <TextBlock x:Uid="RewardsAboutTitle" FontWeight="SemiBold" />
                                                    <TextBlock x:Uid="RewardsAboutBody" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                                <TextBlock x:Name="PlanHintText" x:Uid="RewardsPlanHint" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionSecondaryStyle}" />
                            </StackPanel>

                            <mux:InfoBar x:Name="UnidentifiedBar" IsOpen="False" IsClosable="False"
                                         Severity="Warning"
                                         AutomationProperties.AutomationId="RewardsUnidentifiedBar" />

                            <!-- One tile per card to carry; RenderPlan fills it and
                                 LayoutPlanTiles picks the column count. -->
                            <Grid x:Name="PlanGrid" ColumnSpacing="12" RowSpacing="12"
                                  AutomationProperties.AutomationId="RewardsPlanList" />
                            <TextBlock x:Name="PlanEmptyText" x:Uid="RewardsPlanEmpty" Visibility="Collapsed"
                                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Recent card spending against the best card -->
                    <Border x:Name="ReviewCard" Style="{StaticResource CardStyle}"
                            AutomationProperties.AutomationId="RewardsReviewCard">
                        <StackPanel Spacing="18">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="RewardsReviewTitle" Style="{StaticResource CardTitleStyle}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <SelectorBar x:Name="RangeBar" Grid.Column="1"
                                             AutomationProperties.AutomationId="RewardsRangeBar"
                                             SelectionChanged="RangeBar_SelectionChanged">
                                    <SelectorBarItem x:Uid="RewardsRange1M" Tag="1m" />
                                    <SelectorBarItem x:Name="DefaultRangeItem" x:Uid="RewardsRange3M" Tag="3m" />
                                    <SelectorBarItem x:Uid="RewardsRange1Y" Tag="1y" />
                                </SelectorBar>
                            </Grid>

                            <!-- Three figures split by hairlines, the way the
                                 Investments portfolio card reads. -->
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Uid="RewardsTileSpent" Style="{StaticResource CaptionSecondaryStyle}" />
                                    <TextBlock x:Name="ReviewSpentText" Style="{StaticResource StatAmountStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="ReviewCountText" Style="{StaticResource CaptionSecondaryStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Rectangle Grid.Column="1" Width="1" Fill="{ThemeResource ReferenceCardStrokeBrush}" />
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock x:Uid="RewardsTileEarned" Style="{StaticResource CaptionSecondaryStyle}" />
                                    <TextBlock x:Name="ReviewEarnedText" Style="{StaticResource StatAmountStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               AutomationProperties.AutomationId="RewardsReviewEarned" />
                                    <TextBlock x:Name="ReviewEarnedRateText" Style="{StaticResource CaptionSecondaryStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Rectangle Grid.Column="3" Width="1" Fill="{ThemeResource ReferenceCardStrokeBrush}" />
                                <StackPanel Grid.Column="4" Spacing="4">
                                    <TextBlock x:Uid="RewardsTileMissed" Style="{StaticResource CaptionSecondaryStyle}" />
                                    <TextBlock x:Name="ReviewMissedText" Style="{StaticResource StatAmountStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               AutomationProperties.AutomationId="RewardsReviewMissed" />
                                    <TextBlock x:Name="ReviewBestText" Style="{StaticResource CaptionSecondaryStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="CapturePanel" Spacing="8">
                                <Grid x:Name="CaptureMeter" Height="8" CornerRadius="4"
                                      Background="{ThemeResource ReferenceNeutralTintBrush}"
                                      AutomationProperties.AutomationId="RewardsCaptureBar">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="CaptureEarnedColumn" Width="*" />
                                        <ColumnDefinition x:Name="CaptureMissedColumn" Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="CaptureFill" CornerRadius="4"
                                            Background="{StaticResource ReferenceBlueBrush}" />
                                </Grid>
                                <TextBlock x:Name="CaptureText" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionSecondaryStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="ReviewUnidentifiedText" Visibility="Collapsed" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionSecondaryStyle}" />

                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="RewardsMissesTitle" Style="{StaticResource SectionLabelStyle}" />
                                <StackPanel x:Name="MissList"
                                            AutomationProperties.AutomationId="RewardsMissList" />
                                <TextBlock x:Name="NoMissesText" x:Uid="RewardsNoMisses" Visibility="Collapsed"
                                           Margin="0,6,0,0" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Every category, with its best card -->
                    <Border x:Name="BestCard" Style="{StaticResource CardStyle}"
                            AutomationProperties.AutomationId="RewardsBestCard">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="RewardsBestTitle" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock x:Name="BestHintText" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionSecondaryStyle}" />
                            </StackPanel>
                            <StackPanel>
                                <!-- Column headings; BuildCategoryRow uses the same widths. -->
                                <Grid x:Name="CategoryHeader" ColumnSpacing="12" Padding="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" x:Uid="RewardsColCategory"
                                               Style="{StaticResource CaptionSecondaryStyle}" />
                                    <TextBlock Grid.Column="2" x:Uid="RewardsColBestCard"
                                               Style="{StaticResource CaptionSecondaryStyle}" />
                                    <TextBlock Grid.Column="3" x:Uid="RewardsColMissed" TextAlignment="Right"
                                               Style="{StaticResource CaptionSecondaryStyle}" />
                                </Grid>
                                <Rectangle Style="{StaticResource DividerStyle}" />
                                <StackPanel x:Name="CategoryList"
                                            AutomationProperties.AutomationId="RewardsCategoryList" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SecondaryScroller" Grid.Column="1"
                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Auto" VerticalScrollBarVisibility="Hidden">
                <StackPanel x:Name="SecondaryPanel" Spacing="16">

                    <!-- Which card each account is -->
                    <Border x:Name="CardsCard" Style="{StaticResource CardStyle}"
                            AutomationProperties.AutomationId="RewardsCardsCard">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="RewardsCardsTitle" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock x:Uid="RewardsCardsHint" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionSecondaryStyle}" />
                            </StackPanel>
                            <StackPanel x:Name="CardList"
                                        AutomationProperties.AutomationId="RewardsCardList" />
                        </StackPanel>
                    </Border>

                    <!-- Point values -->
                    <Border x:Name="PointsCard" Style="{StaticResource CardStyle}" Visibility="Collapsed"
                            AutomationProperties.AutomationId="RewardsPointsCard">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="RewardsPointsTitle" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock x:Uid="RewardsPointsHint" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionSecondaryStyle}" />
                            </StackPanel>
                            <StackPanel x:Name="PointValueList" Spacing="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
