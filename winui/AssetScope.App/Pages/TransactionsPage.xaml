<Page
    x:Class="AssetScope.App.Pages.TransactionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mux="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:AssetScope.App.Controls"
    xmlns:local="using:AssetScope.App.Pages"
    AutomationProperties.AutomationId="TransactionsPage"
    Background="{ThemeResource AppCanvasBrush}"
    NavigationCacheMode="Required"
    SizeChanged="TransactionsPage_SizeChanged">

    <Page.Resources>
        <!-- Grouped by posting day. The ListView virtualizes, so a year of
             card activity costs the same as a week. -->
        <CollectionViewSource x:Name="GroupedSource" IsSourceGrouped="True" />
    </Page.Resources>

    <!-- Viewport-sized shell: the list card fills the window and scrolls
         inside its own border; the summary rail scrolls on its own. -->
    <Grid Style="{StaticResource ReferencePageGridStyle}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="12">
            <controls:PageHeader x:Name="Header" />
            <mux:InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="True" Severity="Error" />
        </StackPanel>

        <Grid x:Name="ToolbarGrid" Grid.Row="1" ColumnSpacing="12" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SearchColumn" Width="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" x:Uid="TransactionsSearch" QueryIcon="Find"
                            AutomationProperties.AutomationId="TransactionsSearchBox"
                            VerticalAlignment="Center"
                            TextChanged="SearchBox_TextChanged" />
            <ComboBox x:Name="AccountPicker" Grid.Column="1" MinWidth="176" VerticalAlignment="Center"
                      AutomationProperties.AutomationId="TransactionsAccountPicker"
                      SelectionChanged="AccountPicker_SelectionChanged" />
            <ComboBox x:Name="KindPicker" Grid.Column="2" MinWidth="150" VerticalAlignment="Center"
                      AutomationProperties.AutomationId="TransactionsKindPicker"
                      SelectionChanged="KindPicker_SelectionChanged">
                <ComboBoxItem x:Uid="TransactionsKindAll" Tag="all" />
                <ComboBoxItem x:Uid="TransactionsKindSpending" Tag="spending" />
                <ComboBoxItem x:Uid="TransactionsKindIncome" Tag="income" />
                <ComboBoxItem x:Uid="TransactionsKindTransfers" Tag="transfers" />
            </ComboBox>
            <ScrollViewer x:Name="RangeScroller" Grid.Row="0" Grid.Column="4"
                          HorizontalAlignment="Right"
                          HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <mux:SelectorBar x:Name="RangeBar"
                                 AutomationProperties.AutomationId="TransactionsRangeBar"
                                 SelectionChanged="RangeBar_SelectionChanged">
                    <mux:SelectorBarItem x:Name="Range30DaysItem" x:Uid="TxnRange30D" Tag="30d" />
                    <mux:SelectorBarItem x:Uid="TxnRangeThisMonth" Tag="month" />
                    <mux:SelectorBarItem x:Uid="TxnRangeLastMonth" Tag="lastMonth" />
                    <mux:SelectorBarItem x:Uid="TxnRange3M" Tag="3m" />
                    <mux:SelectorBarItem x:Uid="TxnRange12M" Tag="12m" />
                </mux:SelectorBar>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="ContentGrid" Grid.Row="2" ColumnSpacing="16" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="*" MinWidth="400" />
                <ColumnDefinition x:Name="RailColumn" Width="352" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="ListCard" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                    Style="{StaticResource CardStyle}" Padding="4"
                    AutomationProperties.AutomationId="TransactionsListCard">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="14,10,14,4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CountText" Style="{StaticResource CaptionSecondaryStyle}"
                                   VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="TransactionsCount" />
                        <!-- Active category drill-down, cleared with the ✕. -->
                        <Border x:Name="FilterChip" Grid.Column="1" Visibility="Collapsed"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                CornerRadius="12" Padding="10,2,2,2"
                                Background="{ThemeResource ReferenceBlueTintBrush}"
                                AutomationProperties.AutomationId="TransactionsCategoryChip">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="FilterChipText" FontSize="12" VerticalAlignment="Center" />
                                <Button x:Name="ClearFilterButton" Style="{StaticResource InfoTipButtonStyle}"
                                        AutomationProperties.AutomationId="TransactionsClearCategory"
                                        Click="ClearFilter_Click">
                                    <FontIcon Glyph="&#xE711;" FontSize="10" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <ProgressRing x:Name="LoadingRing" Grid.Column="2" Width="16" Height="16"
                                      IsActive="False" />
                    </Grid>

                    <ListView x:Name="TransactionList" Grid.Row="1"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              ItemClick="TransactionList_ItemClick"
                              SelectionChanged="TransactionList_SelectionChanged"
                              ShowsScrollingPlaceholders="False"
                              AutomationProperties.AutomationId="TransactionsList">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="10,4,10,4" />
                                <Setter Property="Margin" Value="0,1" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderContainerStyle>
                                    <!-- Sticky day headers paint on the card
                                         surface so rows scroll under them cleanly. -->
                                    <Style TargetType="ListViewHeaderItem">
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Background" Value="{ThemeResource ReferenceCardBrush}" />
                                    </Style>
                                </GroupStyle.HeaderContainerStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate x:DataType="local:TransactionGroup">
                                        <Grid Padding="14,12,14,4" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Subtitle}"
                                                       Style="{StaticResource CaptionSecondaryStyle}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:TransactionRow">
                                <Grid ColumnSpacing="12" Padding="4,5,4,5"
                                      AutomationProperties.Name="{x:Bind AccessibleName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8"
                                            Background="{x:Bind TintBrush}" VerticalAlignment="Center">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="14"
                                                  Foreground="{x:Bind GlyphBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Meta}" TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource CaptionSecondaryStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind AmountText}"
                                               Foreground="{x:Bind AmountBrush}"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel x:Name="ListEmptyState" Grid.Row="1" Visibility="Collapsed" Spacing="10"
                                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                                Margin="16">
                        <FontIcon x:Name="ListEmptyIcon" Glyph="&#xE721;" FontSize="32" HorizontalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="ListEmptyTitle" HorizontalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock x:Name="ListEmptyBody" HorizontalAlignment="Center" TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="ListEmptySettingsButton" x:Uid="TransactionsOpenSettings"
                                Visibility="Collapsed" HorizontalAlignment="Center"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OpenSettings_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="RailScroller" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Auto" VerticalScrollBarVisibility="Hidden">
                <StackPanel x:Name="RailPanel" Spacing="16">
                    <Border x:Name="SummaryCard" Style="{StaticResource CardStyle}"
                            AutomationProperties.AutomationId="TransactionsSummaryCard">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="TransactionsSummaryTitle" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock x:Name="PeriodText" Style="{StaticResource CaptionSecondaryStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid x:Name="StatTiles" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StatTileStyle}" Padding="10,8">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Uid="TransactionsMoneyOut" Style="{StaticResource CaptionSecondaryStyle}" />
                                        <TextBlock x:Name="MoneyOutText" FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   AutomationProperties.AutomationId="TransactionsMoneyOutText" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource StatTileStyle}" Padding="10,8">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Uid="TransactionsMoneyIn" Style="{StaticResource CaptionSecondaryStyle}" />
                                        <TextBlock x:Name="MoneyInText" FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource PositiveChangeBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource StatTileStyle}" Padding="10,8">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Uid="TransactionsNet" Style="{StaticResource CaptionSecondaryStyle}" />
                                        <TextBlock x:Name="NetText" FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel x:Name="MonthsSection" Spacing="8" Visibility="Collapsed">
                                <TextBlock x:Uid="TransactionsMonthlyTitle" Style="{StaticResource SectionLabelStyle}" />
                                <Grid x:Name="MonthBars" Height="92" ColumnSpacing="6" />
                            </StackPanel>

                            <Rectangle Style="{StaticResource DividerStyle}" />

                            <StackPanel x:Name="CategorySection" Spacing="10">
                                <TextBlock x:Uid="TransactionsSpendingTitle" Style="{StaticResource SectionLabelStyle}" />
                                <StackPanel x:Name="CategoryList" Spacing="10" />
                                <TextBlock x:Name="NoSpendingText" x:Uid="TransactionsNoSpending"
                                           Visibility="Collapsed" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Uid="TransactionsSpendingHint" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionSecondaryStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="DetailCard" Style="{StaticResource CardStyle}"
                            AutomationProperties.AutomationId="TransactionsDetailCard">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="TransactionsDetailTitle" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock x:Name="DetailEmptyText" x:Uid="TransactionsDetailHint" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel x:Name="DetailContent" Spacing="12" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
