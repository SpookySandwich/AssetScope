<Page
    x:Class="AssetScope.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mux="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:AssetScope.App.Controls"
    Background="{ThemeResource AppCanvasBrush}"
    AutomationProperties.AutomationId="SettingsPage">

    <ScrollViewer HorizontalContentAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Hidden">
        <StackPanel Style="{StaticResource ReferencePageStackStyle}">
            <controls:PageHeader x:Name="Header" />

            <mux:InfoBar x:Name="SyncResultBar" IsOpen="False" IsClosable="True" />

            <Grid x:Name="SettingsColumns" AutomationProperties.AutomationId="SettingsLayout"
                  ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PrimaryColumn" Width="*" />
                    <ColumnDefinition x:Name="SecondaryColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="SettingsPrimary" Grid.Row="0" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="14"
                            AutomationProperties.AutomationId="DataConnectionsSettingsGroup">
                    <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,2,4,4">
                        <TextBlock x:Uid="SettingsConnections" Style="{StaticResource CardTitleStyle}" />
                        <Button Style="{StaticResource InfoTipButtonStyle}">
                            <FontIcon Glyph="&#xE946;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <TextBlock x:Uid="SettingsConnectionsTooltip"
                                               TextWrapping="Wrap" MaxWidth="300" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                    <Grid ColumnSpacing="16" MinHeight="40" Margin="4,2,4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Uid="DemoModeToggleLabel" FontWeight="SemiBold" />
                            <TextBlock x:Uid="DemoModeHint" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="DemoModeToggle" Grid.Column="1"
                                      Style="{StaticResource SettingsToggleSwitchStyle}"
                                      AutomationProperties.AutomationId="DemoModeToggle"
                                      Toggled="DemoModeToggle_Toggled" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <mux:Expander x:Name="BankExpander"
                                  AutomationProperties.AutomationId="AutomaticBankSyncExpander"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch">
                        <mux:Expander.Header>
                            <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="8"
                                        Background="{ThemeResource ReferenceNeutralTintBrush}">
                                    <Image Width="27" Height="27" Stretch="Uniform">
                                        <Image.Source>
                                            <SvgImageSource UriSource="ms-appx:///Assets/Institutions/plaid.svg" />
                                        </Image.Source>
                                    </Image>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Uid="BankHeader" FontWeight="SemiBold" />
                                    <TextBlock x:Name="BankStatusSubtext" FontSize="12"
                                               AutomationProperties.AutomationId="PlaidConnectionStatusText"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button x:Name="ConnectBankButton" x:Uid="ConnectBank" Grid.Column="2"
                                        Style="{StaticResource ConnectionHeaderButtonStyle}"
                                        AutomationProperties.AutomationId="SetUpAutomaticSyncButton"
                                        Click="ConnectBankButton_Click" />
                            </Grid>
                        </mux:Expander.Header>
                        <StackPanel Spacing="14" Padding="4,2,4,6">
                            <mux:InfoBar x:Name="PlaidResultBar" IsOpen="False" IsClosable="True" />
                            <TextBlock x:Name="BankDemoHint" x:Uid="BankDemoHint" TextWrapping="Wrap" FontSize="12"
                                       Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel>
                                <TextBlock x:Uid="InstitutionsHeader" FontWeight="SemiBold" />
                                <TextBlock x:Name="LinkStatusText" FontSize="12" Visibility="Collapsed"
                                           AutomationProperties.AutomationId="AutomaticSyncStatus"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel x:Name="InstitutionsList" Spacing="8"
                                        AutomationProperties.AutomationId="ConnectedInstitutionsList" />
                            <mux:Expander x:Name="PlaidAdvancedExpander"
                                          AutomationProperties.AutomationId="AdvancedPlaidSettingsExpander"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <mux:Expander.Header>
                                    <StackPanel>
                                        <TextBlock x:Uid="AdvancedPlaidHeader" FontWeight="SemiBold" />
                                        <TextBlock x:Uid="AdvancedPlaidSummary" Style="{StaticResource CaptionSecondaryStyle}" />
                                    </StackPanel>
                                </mux:Expander.Header>
                                <StackPanel x:Name="PlaidConfigPanel" Spacing="10" Padding="4">
                                    <TextBlock x:Uid="AdvancedPlaidExplainer" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox x:Name="PlaidClientIdBox" x:Uid="PlaidClientIdBox" MaxLength="64"
                                             AutomationProperties.AutomationId="SettingsPlaidClientIdInput" />
                                    <PasswordBox x:Name="PlaidSecretBox" x:Uid="PlaidSecretBox" MaxLength="128"
                                                 AutomationProperties.AutomationId="SettingsPlaidSecretInput" />
                                    <TextBlock x:Uid="PlaidSecretHint" TextWrapping="Wrap" Style="{StaticResource CaptionSecondaryStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="SaveTestButton" x:Uid="SaveAndTest"
                                                AutomationProperties.AutomationId="SavePlaidCredentialsButton"
                                                Style="{StaticResource AccentButtonStyle}" Click="SaveTestButton_Click" />
                                        <Button x:Name="ImportEnvButton" x:Uid="ImportEnv" Visibility="Collapsed"
                                                AutomationProperties.AutomationId="ImportPlaidCredentialsButton"
                                                Click="ImportEnvButton_Click" />
                                        <ProgressRing x:Name="PlaidBusyRing" Width="18" Height="18" IsActive="False" />
                                    </StackPanel>
                                </StackPanel>
                            </mux:Expander>
                        </StackPanel>
                    </mux:Expander>

                    <mux:Expander x:Name="SnapTradeExpander"
                                  AutomationProperties.AutomationId="SnapTradeConnectionExpander"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch">
                        <mux:Expander.Header>
                            <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="8"
                                        Background="{ThemeResource ReferenceTealTintBrush}">
                                    <Image Width="25" Height="27" Stretch="Uniform">
                                        <Image.Source>
                                            <SvgImageSource UriSource="ms-appx:///Assets/Institutions/snaptrade.svg" />
                                        </Image.Source>
                                    </Image>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="SnapTrade" FontWeight="SemiBold" />
                                    <TextBlock x:Name="SnapTradeStatusText" FontSize="12"
                                               AutomationProperties.AutomationId="SnapTradeConnectionStatusText"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button x:Name="ConnectBrokerageButton" x:Uid="ConnectBrokerage" Grid.Column="2"
                                        Style="{StaticResource ConnectionHeaderButtonStyle}"
                                        Click="ConnectBrokerageButton_Click"
                                        AutomationProperties.AutomationId="ConnectSnapTradeBrokerageButton" />
                            </Grid>
                        </mux:Expander.Header>
                        <StackPanel Spacing="14" Padding="4,4,4,8">
                            <InfoBar x:Name="SnapTradeResultBar" IsOpen="False" IsClosable="True" />
                            <!-- The read-only and not-advice disclaimer belongs
                                 with the connection it describes, stated once,
                                 rather than repeated at the foot of a page the
                                 user reads every day. -->
                            <StackPanel Orientation="Horizontal" Spacing="10"
                                        AutomationProperties.AutomationId="SnapTradeReadOnlyNotice">
                                <FontIcon Glyph="&#xE946;" FontSize="14" VerticalAlignment="Top"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Uid="SnapTradeReadOnlyNotice"
                                           TextWrapping="Wrap" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel x:Name="SnapTradeConnectionsList" Spacing="8"
                                        AutomationProperties.AutomationId="SnapTradeConnectionsList" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="CompleteSnapTradeButton" x:Uid="CompleteSnapTrade"
                                        Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}"
                                        Click="CompleteSnapTradeButton_Click"
                                        AutomationProperties.AutomationId="CompleteSnapTradeConnectionButton" />
                                <ProgressRing x:Name="SnapTradeBusyRing" Width="18" Height="18" IsActive="False" />
                            </StackPanel>
                            <mux:Expander x:Name="SnapTradeAdvancedExpander"
                                          AutomationProperties.AutomationId="AdvancedSnapTradeSettingsExpander"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <mux:Expander.Header>
                                    <StackPanel>
                                        <TextBlock x:Uid="SnapTradeAdvancedTitle" FontWeight="SemiBold" />
                                        <TextBlock x:Uid="SnapTradeAdvancedSummary"
                                                   Style="{StaticResource CaptionSecondaryStyle}" />
                                    </StackPanel>
                                </mux:Expander.Header>
                                <StackPanel Spacing="10" Padding="4">
                                    <Border x:Name="SnapTradeOnboardingPanel"
                                            Background="{ThemeResource ReferenceTealTintBrush}"
                                            CornerRadius="8" Padding="14">
                                        <StackPanel Spacing="8">
                                            <TextBlock x:Uid="SnapTradeOnboardingTitle" FontWeight="SemiBold" />
                                            <TextBlock x:Uid="SnapTradeOnboardingBody" TextWrapping="Wrap"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <HyperlinkButton x:Uid="SnapTradeOpenSignup"
                                                                 NavigateUri="https://dashboard.snaptrade.com/signup" />
                                                <HyperlinkButton x:Uid="SnapTradeOpenApiKey"
                                                                 NavigateUri="https://dashboard.snaptrade.com/api-key" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Uid="SnapTradeCredentialsExplainer"
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox x:Name="SnapTradeClientIdBox" x:Uid="SnapTradeClientIdBox" MaxLength="128"
                                             AutomationProperties.AutomationId="SnapTradeClientIdInput" />
                                    <PasswordBox x:Name="SnapTradeConsumerKeyBox" x:Uid="SnapTradeConsumerKeyBox" MaxLength="256"
                                                 AutomationProperties.AutomationId="SnapTradeConsumerKeyInput" />
                                    <Button x:Name="SaveSnapTradeButton" x:Uid="SaveSnapTrade"
                                            HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}"
                                            Click="SaveSnapTradeButton_Click"
                                            AutomationProperties.AutomationId="SaveSnapTradeCredentialsButton" />
                                </StackPanel>
                            </mux:Expander>
                        </StackPanel>
                    </mux:Expander>

                    <Grid ColumnSpacing="12" Padding="12,10"
                          AutomationProperties.AutomationId="ManualAccountsConnectionRow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="8"
                                Background="{ThemeResource ReferenceBlueTintBrush}">
                            <FontIcon Glyph="&#xE77B;" FontSize="18"
                                      Foreground="{ThemeResource ReferenceBlueTextBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Uid="ManualConnectionTitle" FontWeight="SemiBold" />
                            <TextBlock x:Uid="ManualConnectionStatus" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="2" x:Uid="ManageManualAccounts"
                                VerticalAlignment="Center" Click="ManageManualAccounts_Click"
                                AutomationProperties.AutomationId="ManageManualAccountsButton" />
                    </Grid>
                    </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardStyle}"
                            AutomationProperties.AutomationId="AboutSettingsGroup">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="SettingsAboutTitle" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,6" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource ReferenceBlueTintBrush}">
                                    <Image Source="ms-appx:///Assets/assetscope.png" Width="28" Height="28" Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Uid="AboutTitle" FontWeight="SemiBold" />
                                    <TextBlock x:Name="VersionText" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="2" x:Uid="CheckUpdates" VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="CheckUpdatesButton" />
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource ReferenceCardStrokeBrush}" />
                            <Grid ColumnSpacing="10" Padding="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Uid="OpenSourceLicenseTitle" FontWeight="SemiBold" />
                                </StackPanel>
                                <Button Grid.Column="1" x:Uid="ViewLicense" VerticalAlignment="Center" Click="ViewLicense_Click" />
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource ReferenceCardStrokeBrush}" />
                            <Grid ColumnSpacing="10" Padding="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Uid="HelpFeedbackTitle" FontWeight="SemiBold" />
                                </StackPanel>
                                <Button Grid.Column="1" x:Uid="OpenHelp"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="OpenHelpButton">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                </Button>
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource ReferenceCardStrokeBrush}" />
                            <Grid ColumnSpacing="10" Padding="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Uid="PrivacyPolicyTitle" FontWeight="SemiBold" />
                                </StackPanel>
                                <Button Grid.Column="1" x:Uid="ViewPrivacy"
                                        VerticalAlignment="Center"
                                        Click="ViewPrivacy_Click">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16"
                            AutomationProperties.AutomationId="PrivacySecuritySettingsGroup">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,2,4,4">
                                <TextBlock x:Uid="AdvancedSettingsHeader" Style="{StaticResource CardTitleStyle}" />
                                <Button x:Name="PrivacySecurityInfo"
                                        Style="{StaticResource InfoTipButtonStyle}"
                                        AutomationProperties.AutomationId="PrivacySecurityInfo">
                                    <FontIcon Glyph="&#xE946;" FontSize="12"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">
                                            <TextBlock x:Name="PrivacySecurityTooltip"
                                                       TextWrapping="Wrap" MaxWidth="320" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid ColumnSpacing="16" MinHeight="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="PrivacyToggleLabel" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="PrivacyToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggleSwitchStyle}"
                                              AutomationProperties.AutomationId="PrivacyModeToggle"
                                              Toggled="PrivacyToggle_Toggled" />
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid ColumnSpacing="16" MinHeight="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="PrivacyDefaultToggleLabel" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="PrivacyDefaultToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggleSwitchStyle}"
                                              AutomationProperties.AutomationId="PrivacyDefaultToggle"
                                              Toggled="PrivacyDefaultToggle_Toggled" />
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ClearCredentialsButton" x:Uid="ClearCredentials"
                                        AutomationProperties.AutomationId="ClearCredentialsButton"
                                        Click="ClearCredentialsButton_Click" />
                                <Button x:Name="ClearSnapTradeCredentialsButton" x:Uid="ClearSnapTradeCredentials"
                                        AutomationProperties.AutomationId="ClearSnapTradeCredentialsButton"
                                        Click="ClearSnapTradeCredentialsButton_Click" />
                                <Button x:Name="DeleteAllDataButton" x:Uid="DeleteAllData"
                                        AutomationProperties.AutomationId="DeleteAllDataButton"
                                        Click="DeleteAllDataButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </Grid>

                <StackPanel x:Name="SettingsSecondary" Grid.Row="1" Grid.Column="0" Spacing="16">
                    <Border Style="{StaticResource CardStyle}" Padding="16"
                            AutomationProperties.AutomationId="AppearanceSettingsGroup">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="SettingsPersonalization" Style="{StaticResource CardTitleStyle}" />
                            <Grid ColumnSpacing="14" MinHeight="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE790;" FontSize="16" />
                                    <TextBlock x:Uid="ThemeHeader" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <mux:SelectorBar x:Name="ThemePicker" Grid.Column="1"
                                                 AutomationProperties.AutomationId="ThemeSelector"
                                                 SelectionChanged="ThemePicker_SelectionChanged">
                                    <mux:SelectorBarItem x:Name="ThemeLightItem" x:Uid="ThemeLight" Tag="light"
                                                         AutomationProperties.AutomationId="ThemeLightItem" />
                                    <mux:SelectorBarItem x:Name="ThemeDarkItem" x:Uid="ThemeDark" Tag="dark"
                                                         AutomationProperties.AutomationId="ThemeDarkItem" />
                                    <mux:SelectorBarItem x:Name="ThemeSystemItem" x:Uid="ThemeSystem" Tag="system"
                                                         AutomationProperties.AutomationId="ThemeSystemItem" />
                                </mux:SelectorBar>
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid ColumnSpacing="12" MinHeight="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="DisplayNameLabel" VerticalAlignment="Center" />
                                <TextBox x:Name="DisplayNameBox" x:Uid="DisplayNamePlaceholder" Grid.Column="1"
                                         MaxLength="60" HorizontalAlignment="Stretch"
                                         LostFocus="DisplayNameBox_LostFocus"
                                         AutomationProperties.AutomationId="DisplayNameInput" />
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid ColumnSpacing="12" MinHeight="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="LanguageLabel" VerticalAlignment="Center" />
                                <ComboBox x:Name="LanguagePicker" Grid.Column="1" HorizontalAlignment="Stretch"
                                          SelectionChanged="LanguagePicker_SelectionChanged"
                                          AutomationProperties.AutomationId="LanguagePicker">
                                    <ComboBoxItem x:Uid="LanguageChinese" Tag="zh-CN" />
                                    <ComboBoxItem x:Uid="LanguageEnglish" Tag="en-US" />
                                    <ComboBoxItem x:Uid="LanguageSystem" Tag="system" />
                                </ComboBox>
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid ColumnSpacing="12" MinHeight="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="DefaultCurrencyLabel" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" x:Name="DefaultCurrencyPicker"
                                          SelectedIndex="0" HorizontalAlignment="Stretch">
                                    <ComboBoxItem x:Uid="DefaultCurrencyUsd" />
                                </ComboBox>
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid ColumnSpacing="16" MinHeight="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="StartOnHomeLabel" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="StartOnHomeToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggleSwitchStyle}"
                                              AutomationProperties.AutomationId="StartOnHomeToggle"
                                              Toggled="StartOnHomeToggle_Toggled" />
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid ColumnSpacing="16" MinHeight="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="DecimalsToggleLabel" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="DecimalsToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggleSwitchStyle}"
                                              AutomationProperties.AutomationId="ShowDecimalsToggle"
                                              Toggled="DecimalsToggle_Toggled" />
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid ColumnSpacing="16" MinHeight="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Uid="DensityToggleLabel" FontWeight="SemiBold" />
                                    <TextBlock x:Uid="DensityHint" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="DensityToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggleSwitchStyle}"
                                              AutomationProperties.AutomationId="CompactDensityToggle"
                                              Toggled="DensityToggle_Toggled" />
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid ColumnSpacing="16" MinHeight="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Uid="AnimationsToggleLabel" FontWeight="SemiBold" />
                                    <TextBlock x:Uid="AnimationsHint" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AnimationsToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggleSwitchStyle}"
                                              AutomationProperties.AutomationId="AnimationsToggle"
                                              Toggled="AnimationsToggle_Toggled" />
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid ColumnSpacing="8" MinHeight="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Uid="DataModeHeader" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DataModeSubtext" Style="{StaticResource CaptionSecondaryStyle}" />
                                    <TextBlock x:Name="DataDirText" Style="{StaticResource CaptionSecondaryStyle}" TextTrimming="CharacterEllipsis"
                                               IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <Button x:Name="OpenDataDirButton" Grid.Column="1" x:Uid="OpenFolder"
                                        VerticalAlignment="Center" Click="OpenDataDirButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- The Living page reads this goal; it is edited here so that
                         page never carries a form. -->
                    <Border Style="{StaticResource CardStyle}" Padding="16"
                            AutomationProperties.AutomationId="SavingsGoalSettingsGroup">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE73E;" FontSize="16" />
                                <StackPanel>
                                    <TextBlock x:Uid="SettingsGoalTitle" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock x:Uid="SettingsGoalHint" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid ColumnSpacing="12" MinHeight="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="GoalKindLabel" VerticalAlignment="Center" />
                                <ComboBox x:Name="GoalKindPicker" Grid.Column="1" HorizontalAlignment="Stretch"
                                          SelectionChanged="GoalKindPicker_SelectionChanged"
                                          AutomationProperties.AutomationId="GoalKindPicker">
                                    <ComboBoxItem x:Uid="GoalKindNone" Tag="none" />
                                    <ComboBoxItem x:Uid="GoalKindContribution" Tag="contribution" />
                                    <ComboBoxItem x:Uid="GoalKindTarget" Tag="target" />
                                </ComboBox>
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid ColumnSpacing="12" MinHeight="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="GoalNameLabel" VerticalAlignment="Center" />
                                <TextBox x:Name="GoalLabelBox" Grid.Column="1" MaxLength="60"
                                         LostFocus="GoalLabelBox_LostFocus"
                                         AutomationProperties.AutomationId="GoalLabelBox" />
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid ColumnSpacing="12" MinHeight="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="GoalAmountLabel" VerticalAlignment="Center" />
                                <TextBox x:Name="GoalAmountBox" Grid.Column="1" PlaceholderText="500.00"
                                         LostFocus="GoalAmountBox_LostFocus"
                                         AutomationProperties.AutomationId="GoalAmountBox" />
                            </Grid>
                            <TextBlock x:Name="GoalErrorText" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- What a merchant is (rent, income, …) is the user's own fact when the
                         bank's wording does not say it. It is edited here so the Living
                         page stays read-only. -->
                    <Border Style="{StaticResource CardStyle}" Padding="16"
                            AutomationProperties.AutomationId="LivingLabelsSettingsGroup">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8EC;" FontSize="16" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Uid="SettingsLabelsTitle" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock x:Uid="SettingsLabelsHint" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <StackPanel x:Name="LabelRows" AutomationProperties.AutomationId="LivingLabelRows" />
                            <TextBlock x:Name="NoLabelRowsText" x:Uid="SettingsLabelsEmpty" Visibility="Collapsed"
                                       Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                            <AutoSuggestBox x:Name="LabelSearchBox" x:Uid="SettingsLabelsSearch" QueryIcon="Find"
                                            TextChanged="LabelSearchBox_TextChanged"
                                            QuerySubmitted="LabelSearchBox_QuerySubmitted"
                                            AutomationProperties.AutomationId="LivingLabelSearchBox" />
                            <!-- Detected bills and income already work, so they stay folded away. -->
                            <mux:Expander x:Name="DetectedLabelsExpander" Visibility="Collapsed"
                                          AutomationProperties.AutomationId="LivingDetectedLabelsExpander"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <mux:Expander.Header>
                                    <StackPanel>
                                        <TextBlock x:Name="DetectedLabelsHeaderText" FontWeight="SemiBold" />
                                        <TextBlock x:Uid="SettingsLabelsDetectedSummary" Style="{StaticResource CaptionSecondaryStyle}" />
                                    </StackPanel>
                                </mux:Expander.Header>
                                <StackPanel x:Name="DetectedLabelRows" />
                            </mux:Expander>
                            <TextBlock x:Name="LabelErrorText" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="16"
                            AutomationProperties.AutomationId="BackgroundSyncSettingsGroup">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE895;" FontSize="16" />
                                <StackPanel>
                                    <TextBlock x:Uid="BackgroundUpdatesHeader" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock x:Uid="BackgroundUpdatesSummary" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid ColumnSpacing="16" MinHeight="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Uid="StartupToggleLabel" FontWeight="SemiBold" />
                                    <TextBlock x:Name="StartupStateText" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="StartupToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggleSwitchStyle}"
                                              AutomationProperties.AutomationId="RunAtLoginToggle"
                                              Toggled="StartupToggle_Toggled" />
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid ColumnSpacing="16" MinHeight="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="LaunchSyncToggleLabel" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="LaunchSyncToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggleSwitchStyle}"
                                              AutomationProperties.AutomationId="SyncOnLaunchToggle"
                                              Toggled="LaunchSyncToggle_Toggled" />
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid ColumnSpacing="16" MinHeight="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="DailySyncToggleLabel" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="DailySyncToggle" Grid.Column="1"
                                              Style="{StaticResource SettingsToggleSwitchStyle}"
                                              Toggled="DailySyncToggle_Toggled" />
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid ColumnSpacing="16" MinHeight="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Uid="DailySyncTimeLabel" FontWeight="SemiBold" />
                                    <TextBlock x:Name="LastScheduledText" Style="{StaticResource CaptionSecondaryStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <TimePicker x:Name="DailySyncTime" Grid.Column="1" MinuteIncrement="15"
                                            VerticalAlignment="Center"
                                            TimeChanged="DailySyncTime_TimeChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="16"
                            AutomationProperties.AutomationId="BackupsSettingsGroup">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                                <TextBlock x:Uid="BackupsHeader" Style="{StaticResource CardTitleStyle}" />
                            </StackPanel>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <mux:InfoBar x:Name="BackupResultBar" IsOpen="False" IsClosable="True" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="BackupNowButton" x:Uid="BackupNow" Style="{StaticResource AccentButtonStyle}"
                                        AutomationProperties.AutomationId="BackupNowButton" Click="BackupNowButton_Click" />
                                <Button x:Name="ExportAccountsButton" x:Uid="ExportAccounts"
                                        AutomationProperties.AutomationId="ExportAccountsButton" Click="ExportAccountsButton_Click" />
                                <Button x:Name="ExportNetWorthButton" x:Uid="ExportNetWorth"
                                        AutomationProperties.AutomationId="ExportNetWorthButton" Click="ExportNetWorthButton_Click" />
                            </StackPanel>
                            <TextBlock x:Uid="BackupListHeader" Style="{StaticResource CaptionSecondaryStyle}" />
                            <StackPanel x:Name="BackupsList" Spacing="4" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="16"
                            AutomationProperties.AutomationId="DiagnosticsSettingsGroup">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE9D9;" FontSize="16" />
                                <TextBlock x:Uid="DiagnosticsHeader" Style="{StaticResource CardTitleStyle}" />
                            </StackPanel>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <TextBlock x:Name="DiagnosticsText" FontSize="12" IsTextSelectionEnabled="True"
                                       FontFamily="Consolas" TextWrapping="Wrap" />
                            <TextBlock x:Uid="LogsHeader" Style="{StaticResource CaptionSecondaryStyle}" Margin="0,8,0,0" />
                            <TextBlock x:Name="LogsText" FontSize="11" IsTextSelectionEnabled="True"
                                       FontFamily="Consolas" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Uid="CopyDiagnostics" AutomationProperties.AutomationId="CopyDiagnosticsButton"
                                        Click="CopyDiagnostics_Click" />
                                <Button x:Name="ClearLogsButton" x:Uid="ClearLogs"
                                        AutomationProperties.AutomationId="ClearLogsButton" Click="ClearLogsButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
